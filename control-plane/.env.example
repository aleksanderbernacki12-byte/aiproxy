DATABASE_URL=postgresql://aiproxy:aiproxy@localhost:5432/aiproxy_control
DASHBOARD_SESSION_SECRET=replace-with-at-least-32-random-characters
CRON_SECRET=replace-with-a-long-random-cron-secret
TELEMETRY_REORDER_WINDOW_SECONDS=30
MERKLE_ANCHOR_URL=https://anchor.example/v1/checkpoints
MERKLE_ANCHOR_TOKEN=replace-with-anchor-bearer-token
MERKLE_ANCHOR_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nreplace-with-ed25519-public-key\n-----END PUBLIC KEY-----"
